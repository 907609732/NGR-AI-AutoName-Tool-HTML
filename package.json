{
  "name": "ngr-assetpilot-desktop",
  "version": "3.0.0",
  "private": true,
  "description": "NGR AssetPilot Windows desktop application",
  "license": "MIT",
  "author": "五成（月财）",
  "type": "module",
  "main": "desktop/main/index.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "env:check": "node scripts/check-environment.mjs",
    "test": "node --test tests/*.test.mjs",
